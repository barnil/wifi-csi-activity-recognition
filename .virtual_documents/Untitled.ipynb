def normalize_each_window(X):
    """
    Normalize each CSI window independently.

    X shape:
        (samples, 100 packets, 62 subcarriers)
    """

    mean = X.mean(axis=2, keepdims=True)
    std = X.std(axis=2, keepdims=True)

    std[std < 1e-6] = 1.0

    return (X - mean) / std


