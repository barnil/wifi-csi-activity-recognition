    ).mode[0]

    recording_vote_results.append({
        "recording": recording,
        "true_class": label_encoder.inverse_transform([true_label])[0],
        "predicted_class": label_encoder.inverse_transform(
            [majority_prediction]
        )[0],
        "correct": majority_prediction == true_label,
        "windows": len(indices)
    })

