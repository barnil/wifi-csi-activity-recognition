from scipy.stats import mode

recording_vote_results = []

for recording in np.unique(
    np.array([w["file"] for w in test_windows])
):

    indices = [
        i for i, w in enumerate(test_windows)
        if w["file"] == recording
    ]

    true_label = y_test_encoded[indices[0]]

